# Environment
NODE_ENV=development

# Server
PORT=3000

# Database
MONGODB_URI=mongodb://username:password@localhost:27017/fastchat
POSTGRES_URI=postgresql://username:password@localhost:5432/fastchat
REDIS_URI=redis://:password@localhost:6379

# JWT Secrets (Must be at least 32 characters)
ACCESS_TOKEN_SECRET=your_jwt_secret_minimum_32_characters_long_here

# Expiration
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# File Upload
MAX_FILE_SIZE=5242880