# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
MONGODB_URI="mongodb://username:password@localhost:27017/fastchat"
POSTGRES_URI="postgresql://username:password@localhost:5432/fastchat"
REDIS_URI="redis://:password@localhost:6379"

# ─────────────────────────────────────────────
# JWT Configuration
# ─────────────────────────────────────────────
ACCESS_TOKEN_SECRET="your_access_token_secret_minimum_32_characters_long"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:5500"

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL="info"

# ─────────────────────────────────────────────
# File Upload
# ─────────────────────────────────────────────
MAX_FILE_SIZE="5242880"

# ─────────────────────────────────────────────
# AWS
# ─────────────────────────────────────────────
S3_ENABLED="false"
AWS_REGION="your_aws_region"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
S3_BUCKET_NAME="your_s3_bucket_name"